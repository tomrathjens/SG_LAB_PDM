<?xml version="1.0" encoding="utf-8"?>
<robot name="full_assembly_robot_unit">

  <material name="chassis_color">
    <color rgba="0.792 0.820 0.933 1" />
  </material>
  <material name="leg_color">
    <color rgba="0.502 1.0 0.502 1" />
  </material>

  <link name="chassis_link">
    <inertial>
      <origin xyz="0 -0.0015 -0.0049" rpy="0 0 0" />
      <mass value="0.0481" />
      <inertia ixx="1.171e-05" ixy="0" ixz="0" iyy="3.222e-05" iyz="8.178e-08" izz="2.354e-05" />
    </inertial>
    <visual>
      <geometry>
        <mesh filename="meshes/chassis_link.STL" />
      </geometry>
      <material name="chassis_color"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="meshes/chassis_link.STL" />
      </geometry>
    </collision>
  </link>

  <link name="wheel_right_link">
    <inertial>
      <origin xyz="-0.004 0 0" rpy="0 0 0" />
      <mass value="0.00087" />
      <inertia ixx="1.378e-08" ixy="0" ixz="0" iyy="1.257e-08" iyz="0" izz="1.257e-08" />
    </inertial>
    <visual>
      <geometry>
        <mesh filename="meshes/wheel_right_link.STL" />
      </geometry>
      <material name="leg_color"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="meshes/wheel_right_link.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="wheel_right_joint" type="continuous">
    <origin xyz="-0.0226 0.009 -0.0219" rpy="3.1416 0 3.1416" />
    <parent link="chassis_link" />
    <child link="wheel_right_link" />
    <axis xyz="1 0 0" />
  </joint>

  <link name="wheel_left_link">
    <inertial>
      <origin xyz="-0.004 0 0" rpy="0 0 0" />
      <mass value="0.00087" />
      <inertia ixx="1.378e-08" ixy="0" ixz="0" iyy="1.257e-08" iyz="0" izz="1.257e-08" />
    </inertial>
    <visual>
      <geometry>
        <mesh filename="meshes/wheel_left_link.STL" />
      </geometry>
      <material name="leg_color"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="meshes/wheel_left_link.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="wheel_left_joint" type="continuous">
    <origin xyz="0.0226 0.009 -0.0219" rpy="0 0 0" />
    <parent link="chassis_link" />
    <child link="wheel_left_link" />
    <axis xyz="-1 0 0" />
  </joint>

  <link name="right_leg_link">
    <inertial>
      <origin xyz="0 0 0.0022" rpy="0 0 0" />
      <mass value="0.000068" />
      <inertia ixx="1.947e-10" ixy="0" ixz="0" iyy="1.947e-10" iyz="0" izz="1.734e-10" />
    </inertial>
    <visual>
      <geometry>
        <mesh filename="meshes/right_leg_link.STL" />
